# Server Configuration
PORT=5000

# LaunchDarkly Configuration
LD_SDK_KEY=your-launchdarkly-server-sdk-key
VITE_LD_CLIENTSIDE_ID=your-launchdarkly-client-side-id

# Observability Configuration
SERVICE_VERSION=v1.0.0
NODE_ENV=development

# LaunchDarkly Observability Environment Variables
# Enable filesystem instrumentation (default: false)
LAUNCHDARKLY_OTEL_NODE_ENABLE_FILESYSTEM_INSTRUMENTATION=false
# Enable outgoing HTTP instrumentation (default: true)
LAUNCHDARKLY_OTEL_NODE_ENABLE_OUTGOING_HTTP_INSTRUMENTATION=true